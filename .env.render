# LEJIO FRI - Render Environment Variables Template
# Copy this to Render dashboard and fill in the values

# Node.js environment
NODE_ENV=production

# Database Connection (PostgreSQL on Render)
DB_HOST=your-render-postgres-host.c.rendering.com
DB_PORT=5432
DB_NAME=lejio_fri
DB_USER=postgres
DB_PASSWORD=your-secure-postgres-password
DB_SSL=true

# Application Settings
PORT=3000
VITE_API_URL=https://your-render-app.onrender.com

# Authentication (if using Supabase)
VITE_SUPABASE_URL=your-supabase-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Upload Service (if using Azure Blob Storage)
VITE_AZURE_STORAGE_ACCOUNT=your-storage-account
VITE_AZURE_STORAGE_CONTAINER=your-container
VITE_AZURE_STORAGE_SAS_URL=your-sas-url

# Sentry Error Tracking (optional)
VITE_SENTRY_DSN=your-sentry-dsn
SENTRY_AUTH_TOKEN=your-sentry-token

# Optional: Monitoring
LOG_LEVEL=info
